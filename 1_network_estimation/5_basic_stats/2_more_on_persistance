# Helpers ---------------------------------------------------------------------
read_migration_matrix <- function(path) {
	year <- as.integer(gsub("\\D", "", basename(path)))

	read_excel(path) %>%
		transmute(
			year = year,
			mx_state = as.character(mx_state),
			mx_municipality = as.character(mx_municipality),
			florida_migrants = coalesce(as.numeric(Florida), 0)
		) %>%
		filter(mx_state != "Total", mx_municipality != "Total") %>%
		mutate(
			corridor_id = paste(mx_state, mx_municipality, "Florida", sep = " -> "),
			active = florida_migrants > 0
		)
}

read_weighted_migration_matrix <- function(path) {
	year <- as.integer(gsub("\\D", "", basename(path)))
	matrix_df <- read_excel(path)
	state_columns <- setdiff(names(matrix_df), c("mx_state", "mx_municipality", "Total"))

	matrix_df %>%
		filter(mx_state != "Total", mx_municipality != "Total") %>%
		pivot_longer(
			cols = all_of(state_columns),
			names_to = "us_state",
			values_to = "weighted_migrants"
		) %>%
		transmute(
			year = year,
			mx_state = as.character(mx_state),
			mx_municipality = as.character(mx_municipality),
			us_state = as.character(us_state),
			weighted_migrants = coalesce(as.numeric(weighted_migrants), 0),
			matrix_cell_id = paste(mx_state, mx_municipality, us_state, sep = " -> ")
		)
}

save_plot <- function(plot, file_name, width, height, dpi = 300) {
	ggsave(
		filename = file.path(output_dir, file_name),
		plot = plot,
		width = width,
		height = height,
		dpi = dpi,
		bg = "white"
	)
}

safe_cor <- function(x) {
	if (nrow(x) == 0 || ncol(x) == 0) {
		return(matrix(numeric(0), nrow = 0, ncol = 0))
	}

	suppressWarnings(cor(x, use = "pairwise.complete.obs"))
}

matrix_files <- list.files(
	migration_matrix_dir,
	pattern = "^MIGRATION_MATRIX_\\d{4}\\.xlsx$",
	full.names = TRUE
)

if (length(matrix_files) == 0) {
	stop("No yearly migration matrices found in: ", migration_matrix_dir)
}

# Florida corridor panel -------------------------------------------------------
florida_corridor_yearly <- bind_rows(lapply(matrix_files, read_migration_matrix)) %>%
	arrange(mx_state, mx_municipality, year)

weighted_migration_matrix_yearly <- bind_rows(lapply(matrix_files, read_weighted_migration_matrix)) %>%
	arrange(mx_state, mx_municipality, us_state, year)

all_years <- sort(unique(florida_corridor_yearly$year))
total_years <- length(all_years)

# Full weighted migration matrix persistence ---------------------------------
weighted_migration_matrix_wide <- weighted_migration_matrix_yearly %>%
	select(matrix_cell_id, year, weighted_migrants) %>%
	pivot_wider(
		names_from = year,
		values_from = weighted_migrants,
		values_fill = 0,
		names_prefix = "year_"
	) %>%
	arrange(matrix_cell_id)

weighted_migration_matrix_values <- weighted_migration_matrix_wide %>%
	select(starts_with("year_")) %>%
	as.matrix()

weighted_migration_year_correlation <- safe_cor(weighted_migration_matrix_values)

weighted_migration_year_correlation_long <- as.data.frame(
	as.table(weighted_migration_year_correlation)
) %>%
	transmute(
		base_year = as.integer(gsub("year_", "", Var1)),
		comparison_year = as.integer(gsub("year_", "", Var2)),
		pearson_correlation = Freq
	)

weighted_migration_consecutive_correlation <- weighted_migration_year_correlation_long %>%
	filter(comparison_year == base_year + 1L) %>%
	transmute(
		year_from = base_year,
		year_to = comparison_year,
		pearson_correlation = pearson_correlation
	)

weighted_migration_base_year_lines <- weighted_migration_year_correlation_long %>%
	mutate(
		base_year = as.integer(base_year),
		comparison_year = as.integer(comparison_year),
		highlight_base_year = case_when(
			base_year == min(all_years) ~ as.character(base_year),
			base_year == 2015L ~ as.character(base_year),
			TRUE ~ "Other base years"
		)
	)

# Extensive margin: how many Florida paths are active each year ----------------
florida_extensive_margin <- florida_corridor_yearly %>%
	group_by(year) %>%
	summarise(
		active_paths = sum(active, na.rm = TRUE),
		total_paths = n_distinct(corridor_id),
		inactive_paths = total_paths - active_paths,
		active_path_share = active_paths / total_paths,
		total_florida_migrants = sum(florida_migrants, na.rm = TRUE),
		mean_migrants_active_path = if_else(
			active_paths > 0,
			total_florida_migrants / active_paths,
			NA_real_
		),
		.groups = "drop"
	)

observed_florida_years <- florida_extensive_margin %>%
	filter(total_florida_migrants > 0, active_paths > 0) %>%
	pull(year)

missing_or_zero_florida_years <- setdiff(all_years, observed_florida_years)
total_observed_florida_years <- length(observed_florida_years)

florida_corridor_persistence <- florida_corridor_yearly %>%
	group_by(mx_state, mx_municipality, corridor_id) %>%
	summarise(
		years_observed = n_distinct(year),
		active_years = sum(active, na.rm = TRUE),
		active_year_share = active_years / years_observed,
		total_florida_migrants = sum(florida_migrants, na.rm = TRUE),
		mean_annual_florida_migrants = mean(florida_migrants, na.rm = TRUE),
		sd_annual_florida_migrants = sd(florida_migrants, na.rm = TRUE),
		coefficient_of_variation = if_else(
			mean_annual_florida_migrants > 0,
			sd_annual_florida_migrants / mean_annual_florida_migrants,
			NA_real_
		),
		.groups = "drop"
	) %>%
	filter(total_florida_migrants > 0) %>%
	mutate(
		persistence_class = case_when(
			active_years == total_years & coefficient_of_variation <= 0.50 ~ "Always active / stable",
			active_years == total_years ~ "Always active / volatile",
			active_year_share >= 0.80 ~ "Highly persistent",
			active_year_share >= 0.50 ~ "Intermittent",
			TRUE ~ "Sparse"
		)
	) %>%
	arrange(desc(total_florida_migrants), desc(active_year_share))

florida_persistence_by_class <- florida_corridor_persistence %>%
	count(persistence_class, name = "corridors") %>%
	mutate(corridor_share = corridors / sum(corridors)) %>%
	arrange(desc(corridors))

# Year-to-year extensive-margin correlation: active/inactive status ------------
florida_active_status_wide <- florida_corridor_yearly %>%
	select(corridor_id, year, active) %>%
	mutate(active = as.integer(active)) %>%
	pivot_wider(
		names_from = year,
		values_from = active,
		values_fill = 0,
		names_prefix = "year_"
	) %>%
	arrange(corridor_id)

active_status_matrix <- florida_active_status_wide %>%
	select(starts_with("year_")) %>%
	as.matrix()

safe_cor <- function(x) {
	if (nrow(x) == 0 || ncol(x) == 0) {
		return(matrix(numeric(0), nrow = 0, ncol = 0))
	}

	cor_matrix <- suppressWarnings(cor(x, use = "pairwise.complete.obs"))
	cor_matrix
}

florida_active_status_year_correlation <- safe_cor(active_status_matrix)

florida_active_status_year_correlation_long <- as.data.frame(
	as.table(florida_active_status_year_correlation)
) %>%
	transmute(
		year_1 = as.integer(gsub("year_", "", Var1)),
		year_2 = as.integer(gsub("year_", "", Var2)),
		active_status_correlation = Freq
	)

# Intensive margin: flow correlations among corridors active in every observed
# Florida year. Raw 2013 has no Florida flows, so the intensive margin excludes
# all-zero Florida years and records them in the key statistics output.
always_active_florida_corridors <- florida_corridor_persistence %>%
	filter(active_years == total_observed_florida_years) %>%
	select(mx_state, mx_municipality, corridor_id)

florida_always_active_flows_wide <- florida_corridor_yearly %>%
	filter(year %in% observed_florida_years) %>%
	semi_join(always_active_florida_corridors, by = c("mx_state", "mx_municipality", "corridor_id")) %>%
	select(corridor_id, year, florida_migrants) %>%
	pivot_wider(
		names_from = year,
		values_from = florida_migrants,
		names_prefix = "year_"
	) %>%
	arrange(corridor_id)

always_active_flow_matrix <- florida_always_active_flows_wide %>%
	select(starts_with("year_")) %>%
	as.matrix()

florida_intensive_year_correlation <- safe_cor(always_active_flow_matrix)

florida_intensive_year_correlation_long <- as.data.frame(
	as.table(florida_intensive_year_correlation)
) %>%
	transmute(
		year_1 = as.integer(gsub("year_", "", Var1)),
		year_2 = as.integer(gsub("year_", "", Var2)),
		intensive_flow_correlation = Freq
	)

