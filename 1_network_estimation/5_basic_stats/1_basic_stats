	summarise(total_migrants = sum(migrants, na.rm = TRUE), .groups = "drop") %>%
	arrange(total_migrants) %>%
	mutate(
		destination_rank = row_number(),
		cumulative_destinations = destination_rank / n(),
		cumulative_migrants = cumsum(total_migrants) / sum(total_migrants),
		equality_line = cumulative_destinations
	) %>%
	bind_rows(
		tibble(
			us_state = "Origin",
			total_migrants = 0,
			destination_rank = 0,
			cumulative_destinations = 0,
			cumulative_migrants = 0,
			equality_line = 0
		),
		.
	) %>%
	arrange(destination_rank)

migration_destination_gini <- lorenz_curve_data %>%
	filter(destination_rank > 0) %>%
	summarise(
		gini = 1 - sum(
			(cumulative_migrants + lag(cumulative_migrants, default = 0)) *
				(cumulative_destinations - lag(cumulative_destinations, default = 0))
		)
	)

