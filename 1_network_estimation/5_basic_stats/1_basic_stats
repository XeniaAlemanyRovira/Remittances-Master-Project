# Descriptive corridor statistics from yearly migration matrices
yearly_migration_long <- bind_rows(lapply(names(yearly_migration_matrices), function(file_name) {
	year <- as.integer(gsub("\\D", "", file_name))

	yearly_migration_matrices[[file_name]] %>%
		mutate(year = year) %>%
		pivot_longer(
			cols = -c(any_of(c("mx_state", "mx_municipality", "Total", "year"))),
			names_to = "us_state",
			values_to = "migrants"
		) %>%
		filter(mx_state != "Total", mx_municipality != "Total") %>%
		mutate(migrants = coalesce(as.numeric(migrants), 0))
}))

concentration_ratio <- yearly_migration_long %>%
	group_by(mx_state, mx_municipality, us_state) %>%
	summarise(total_migrants_to_state = sum(migrants, na.rm = TRUE), .groups = "drop") %>%
	group_by(mx_state, mx_municipality) %>%
	mutate(total_migrants_from_municipality = sum(total_migrants_to_state, na.rm = TRUE)) %>%
	filter(total_migrants_from_municipality > 0) %>%
	slice_max(total_migrants_to_state, n = 1, with_ties = FALSE) %>%
	ungroup() %>%
	transmute(
		mx_state,
		mx_municipality,
		top_us_state = us_state,
		total_migrants_from_municipality,
		migrants_to_top_state = total_migrants_to_state,
		concentration_ratio = if_else(
			total_migrants_from_municipality > 0,
			migrants_to_top_state / total_migrants_from_municipality,
			NA_real_
		),
		concentration_pct = concentration_ratio * 100,
		exposure_level = case_when(
			concentration_ratio >= 0.90 ~ "Highly exposed",
			concentration_ratio >= 0.75 ~ "Moderately exposed",
			TRUE ~ "Diversified"
		)
	) %>%
	arrange(desc(concentration_ratio), desc(total_migrants_from_municipality))

corridor_stability <- yearly_migration_long %>%
	group_by(mx_state, mx_municipality, us_state) %>%
	summarise(
		mean_annual_flow = mean(migrants, na.rm = TRUE),
		sd_annual_flow = sd(migrants, na.rm = TRUE),
		min_annual_flow = min(migrants, na.rm = TRUE),
		max_annual_flow = max(migrants, na.rm = TRUE),
		total_migrants = sum(migrants, na.rm = TRUE),
		years_observed = n_distinct(year),
		nonzero_years = sum(migrants > 0, na.rm = TRUE),
		.groups = "drop"
	) %>%
	filter(total_migrants > 0) %>%
	mutate(
		coefficient_of_variation = if_else(mean_annual_flow > 0, sd_annual_flow / mean_annual_flow, NA_real_),
		nonzero_year_share = nonzero_years / years_observed,
		stability_type = case_when(
			nonzero_year_share == 1 & coefficient_of_variation <= 0.50 ~ "Permanent / stable",
			nonzero_year_share >= 0.80 ~ "Permanent / moderate volatility",
			nonzero_year_share <= 0.40 | coefficient_of_variation >= 1 ~ "Seasonal / volatile",
			TRUE ~ "Intermittent"
		)
	) %>%
	arrange(desc(total_migrants), sd_annual_flow)

