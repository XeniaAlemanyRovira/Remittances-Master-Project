save_and_print_plot <- function(plot, file_name, width, height, dpi = 300) {
	if (interactive()) {
		print(plot)
	}
	ggsave(
		filename = file.path(plot_output_dir, file_name),
		plot = plot,
		width = width,
		height = height,
		dpi = dpi,
		bg = "white"
	)
}

