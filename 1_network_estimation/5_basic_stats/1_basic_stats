# Helpers
read_any <- function(path) {
	ext <- tolower(tools::file_ext(path))
	if (ext %in% c("csv", "txt")) {
		read_csv(path, show_col_types = FALSE)
	} else if (ext %in% c("xlsx", "xls")) {
		read_excel(path)
	} else {
		stop("Unsupported file type: ", path)
	}
}

basic_stats <- function(df) {
	num_df <- df %>% select(where(is.numeric))
	tibble(
		rows = nrow(df),
		cols = ncol(df),
		numeric_cols = ncol(num_df),
		missing_values = sum(is.na(df)),
		sum_values = if (ncol(num_df) > 0) sum(as.matrix(num_df), na.rm = TRUE) else NA_real_,
		mean_value = if (ncol(num_df) > 0) mean(unlist(num_df), na.rm = TRUE) else NA_real_,
		min_value = if (ncol(num_df) > 0) min(unlist(num_df), na.rm = TRUE) else NA_real_,
		max_value = if (ncol(num_df) > 0) max(unlist(num_df), na.rm = TRUE) else NA_real_
	)
}

make_join_key <- function(x) {
	x %>%
		iconv(from = "", to = "ASCII//TRANSLIT") %>%
		toupper() %>%
		gsub("[^A-Z0-9 ]", " ", x = .) %>%
		gsub("[[:space:]]+", " ", x = .) %>%
		trimws()
}

